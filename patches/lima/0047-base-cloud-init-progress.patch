-				cancel(fmt.Errorf("Linux 基础环境未就绪，连续 %s 没有观察到 APT 下载进度: %w", idle, context.DeadlineExceeded))
+				cancel(fmt.Errorf("Linux 基础环境未就绪，连续 %s 没有观察到 cloud-init 输出或 APT 下载进度: %w", idle, context.DeadlineExceeded))
