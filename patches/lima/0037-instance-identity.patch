diff --git a/pkg/guestidentity/identity.go b/pkg/guestidentity/identity.go
new file mode 100644
index 0000000..c5a2071
--- /dev/null
+++ b/pkg/guestidentity/identity.go
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// Package guestidentity creates public, per-environment machine identifiers.
+// These identifiers are not credentials and must never be used for authentication.
+package guestidentity
+
+import (
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"regexp"
+	"strings"
+)
+
+type Identity struct {
+	Hostname          string `json:"hostname" yaml:"hostname"`
+	UUID              string `json:"uuid" yaml:"uuid"`
+	MACAddress        string `json:"macAddress" yaml:"macAddress"`
+	GatewayMACAddress string `json:"gatewayMacAddress" yaml:"gatewayMacAddress"`
+}
+
+// New creates a stable instance name, UUID and network addresses.
+// Persist its result at creation; reconnecting must reuse the saved identity.
+func New() (*Identity, error) { return generate(rand.Reader) }
+
+func generate(random io.Reader) (*Identity, error) {
+	var b [28]byte
+	if _, err := io.ReadFull(random, b[:]); err != nil {
+		return nil, err
+	}
+	b[6] = b[6]&0x0f | 0x40
+	b[8] = b[8]&0x3f | 0x80
+	mac := func(raw []byte) string {
+		raw[0] = raw[0]&0xfc | 0x02 // locally administered, unicast
+		return net.HardwareAddr(raw).String()
+	}
+	guest, gateway := mac(b[16:22]), mac(b[22:28])
+	if guest == gateway {
+		b[27] ^= 1
+		gateway = mac(b[22:28])
+	}
+	return &Identity{
+		Hostname:   fmt.Sprintf("cage-%x", b[:5]),
+		UUID:       fmt.Sprintf("%x-%x-%x-%x-%x", b[:4], b[4:6], b[6:8], b[8:10], b[10:16]),
+		MACAddress: guest, GatewayMACAddress: gateway,
+	}, nil
+}
+
+var hostnamePattern = regexp.MustCompile(`^[A-Za-z][A-Za-z0-9-]{0,13}[A-Za-z0-9]$`)
+var uuidPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+
+func (i *Identity) Validate() error {
+	if i == nil || !hostnamePattern.MatchString(i.Hostname) || !uuidPattern.MatchString(i.UUID) {
+		return errors.New("invalid guest hostname or UUID")
+	}
+	for _, text := range []string{i.MACAddress, i.GatewayMACAddress} {
+		mac, err := net.ParseMAC(text)
+		if err != nil || len(mac) != 6 || mac.String() != text || mac[0]&3 != 2 {
+			return errors.New("guest MAC must be a canonical locally administered unicast address")
+		}
+	}
+	if i.MACAddress == i.GatewayMACAddress {
+		return errors.New("guest and gateway MAC must differ")
+	}
+	return nil
+}
+
+// MachineID is the systemd/D-Bus representation of the environment UUID.
+func (i *Identity) MachineID() string { return strings.ReplaceAll(i.UUID, "-", "") }
diff --git a/pkg/guestidentity/identity_test.go b/pkg/guestidentity/identity_test.go
new file mode 100644
index 0000000..9257428
--- /dev/null
+++ b/pkg/guestidentity/identity_test.go
@@ -0,0 +1,93 @@
+package guestidentity
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"testing"
+)
+
+func TestNewIndependentIdentities(t *testing.T) {
+	names, ids, macs := map[string]bool{}, map[string]bool{}, map[string]bool{}
+	for range 1000 {
+		identity, err := New()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := identity.Validate(); err != nil {
+			t.Fatal(err)
+		}
+		if !strings.HasPrefix(identity.Hostname, "cage-") {
+			t.Fatal("unexpected instance name")
+		}
+		if len(identity.Hostname) > 15 || names[identity.Hostname] || ids[identity.UUID] {
+			t.Fatal("duplicate or invalid machine identity")
+		}
+		names[identity.Hostname], ids[identity.UUID] = true, true
+		for _, value := range []string{identity.MACAddress, identity.GatewayMACAddress} {
+			address, err := net.ParseMAC(value)
+			if err != nil || len(address) != 6 || address[0]&3 != 2 || macs[value] {
+				t.Fatal("duplicate or invalid MAC")
+			}
+			macs[value] = true
+		}
+		if len(identity.MachineID()) != 32 {
+			t.Fatal("invalid systemd machine ID")
+		}
+		data, err := json.Marshal(identity)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var restored Identity
+		if err := json.Unmarshal(data, &restored); err != nil || restored != *identity {
+			t.Fatal("identity did not round trip")
+		}
+	}
+}
+
+func TestRandomnessFailureAndMACCollision(t *testing.T) {
+	// Check every truncation of a deterministic valid generation, including
+	// failures after the hostname has already consumed its random bytes.
+	random := bytes.NewReader(make([]byte, 128))
+	identity, err := generate(random)
+	consumed := 128 - random.Len()
+	for size := range consumed {
+		if _, err := generate(bytes.NewReader(make([]byte, size))); !errors.Is(err, io.EOF) && !errors.Is(err, io.ErrUnexpectedEOF) {
+			t.Fatalf("accepted short random input of %d bytes: %v", size, err)
+		}
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := identity.Validate(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestValidateRejectsUnsafeIdentity(t *testing.T) {
+	identity, err := New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mutate := range []func(*Identity){
+		func(i *Identity) { i.Hostname = "bad;command" },
+		func(i *Identity) { i.Hostname = strings.Repeat("a", 16) },
+		func(i *Identity) { i.UUID = "not-a-uuid" },
+		func(i *Identity) { i.MACAddress = "01:00:00:00:00:00" },
+		func(i *Identity) { i.MACAddress = "00:00:00:00:00:00" },
+		func(i *Identity) { i.GatewayMACAddress = i.MACAddress },
+	} {
+		broken := *identity
+		mutate(&broken)
+		if broken.Validate() == nil {
+			t.Fatal("accepted invalid identity")
+		}
+	}
+	var absent *Identity
+	if absent.Validate() == nil {
+		t.Fatal("accepted nil identity")
+	}
+}
