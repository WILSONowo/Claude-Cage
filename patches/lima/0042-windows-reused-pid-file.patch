diff --git a/pkg/store/process_windows.go b/pkg/store/process_windows.go
new file mode 100644
index 00000000..6a014c80
--- /dev/null
+++ b/pkg/store/process_windows.go
@@ -0,0 +1,69 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package store
+
+import (
+	"fmt"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// FAT-family file systems round write times down by up to two seconds, which
+// would otherwise make a live owner look newer than its own PID file.
+const pidFileTimeSlack = 2 * time.Second
+
+// A process created after the PID file was written cannot be its owner. This
+// also covers old PID files without a boot marker (Windows has no boot ID).
+// Query failures retain the marker: they do not prove that its owner is gone.
+func processStartedAfter(pid int, modified time.Time) (bool, error) {
+	handle, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, uint32(pid))
+	if err == nil {
+		defer windows.CloseHandle(handle)
+		var created, exited, kernel, user windows.Filetime
+		if windows.GetProcessTimes(handle, &created, &exited, &kernel, &user) == nil && created != (windows.Filetime{}) {
+			return created.Nanoseconds() > modified.Add(pidFileTimeSlack).UnixNano(), nil
+		}
+	}
+	// The snapshot includes processes whose handles we cannot open.
+	created, ok := processCreationTimeFromSnapshot(pid)
+	if !ok {
+		return false, fmt.Errorf("cannot confirm creation time of Windows process %d", pid)
+	}
+	return created > modified.Add(pidFileTimeSlack).UnixNano(), nil
+}
+
+func processCreationTimeFromSnapshot(pid int) (int64, bool) {
+	size := uint32(64 * 1024)
+	for size <= 64<<20 {
+		buf := make([]byte, size)
+		var length uint32
+		err := windows.NtQuerySystemInformation(windows.SystemProcessInformation, unsafe.Pointer(&buf[0]), size, &length)
+		if err == windows.STATUS_INFO_LENGTH_MISMATCH {
+			size = max(size*2, length)
+			continue
+		}
+		if err != nil || length > uint32(len(buf)) {
+			return 0, false
+		}
+		buf = buf[:length]
+		for len(buf) >= int(unsafe.Sizeof(windows.SYSTEM_PROCESS_INFORMATION{})) {
+			info := (*windows.SYSTEM_PROCESS_INFORMATION)(unsafe.Pointer(&buf[0]))
+			if info.UniqueProcessID == uintptr(pid) {
+				if info.CreateTime <= 0 {
+					return 0, false
+				}
+				created := windows.Filetime{LowDateTime: uint32(info.CreateTime), HighDateTime: uint32(info.CreateTime >> 32)}
+				return created.Nanoseconds(), true
+			}
+			if uintptr(info.NextEntryOffset) < unsafe.Sizeof(*info) || info.NextEntryOffset > uint32(len(buf)) {
+				break
+			}
+			buf = buf[info.NextEntryOffset:]
+		}
+		return 0, false
+	}
+	return 0, false
+}
diff --git a/pkg/store/process_windows_test.go b/pkg/store/process_windows_test.go
new file mode 100644
index 00000000..0f0a2097
--- /dev/null
+++ b/pkg/store/process_windows_test.go
@@ -0,0 +1,144 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package store
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+
+	"github.com/lima-vm/lima/v2/pkg/osutil"
+)
+
+func TestProcessCreationTimeFromSnapshot(t *testing.T) {
+	if os.Getenv("LIMA_TEST_PROCESS_CREATION_TIME_CHILD") == "1" {
+		if _, err := io.Copy(io.Discard, os.Stdin); err != nil {
+			t.Fatal(err)
+		}
+		return
+	}
+	cmd := exec.Command(os.Args[0], "-test.run=^TestProcessCreationTimeFromSnapshot$")
+	cmd.Env = append(os.Environ(), "LIMA_TEST_PROCESS_CREATION_TIME_CHILD=1")
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		_ = stdin.Close()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = stdin.Close()
+		if err := cmd.Wait(); err != nil {
+			t.Error(err)
+		}
+	})
+	for _, tc := range []struct {
+		name string
+		pid  int
+	}{
+		{"current", os.Getpid()},
+		{"child", cmd.Process.Pid},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			handle, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, uint32(tc.pid))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer windows.CloseHandle(handle)
+			var created, exited, kernel, user windows.Filetime
+			if err := windows.GetProcessTimes(handle, &created, &exited, &kernel, &user); err != nil {
+				t.Fatal(err)
+			}
+			got, ok := processCreationTimeFromSnapshot(tc.pid)
+			if !ok || got != created.Nanoseconds() {
+				t.Fatalf("snapshot creation time = %d, %v; GetProcessTimes = %d", got, ok, created.Nanoseconds())
+			}
+		})
+	}
+	if created, ok := processCreationTimeFromSnapshot(-1); ok {
+		t.Fatalf("nonexistent PID found: %d", created)
+	}
+}
+
+func TestReadPIDFileRejectsReusedWindowsPID(t *testing.T) {
+	for _, boot := range []string{"missing", "unsupported", "current"} {
+		t.Run(boot, func(t *testing.T) {
+			original := bootSessionID
+			bootSessionID = func() (string, error) { return "boot-1", nil }
+			if boot == "unsupported" {
+				bootSessionID = func() (string, error) { return "", osutil.ErrBootSessionNotSupported }
+			}
+			t.Cleanup(func() { bootSessionID = original })
+			dir := t.TempDir()
+			if boot == "current" {
+				if err := writeBootSessionMarker(dir, "boot-1"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, name := range []string{"ha.pid", "qemu.pid"} {
+				path := filepath.Join(dir, name)
+				if err := os.WriteFile(path, fmt.Appendf(nil, "%d\n", os.Getpid()), 0o644); err != nil {
+					t.Fatal(err)
+				}
+				// Model a file left by an earlier owner of this still-live PID.
+				old := time.Date(2000, 1, 1, 0, 0, 0, 0, time.UTC)
+				if err := os.Chtimes(path, old, old); err != nil {
+					t.Fatal(err)
+				}
+				if pid, err := ReadPIDFile(path); err != nil || pid != 0 {
+					t.Fatalf("reused PID accepted: %d, %v", pid, err)
+				}
+				if _, err := os.Stat(path); err != nil {
+					t.Fatal("reader removed the marker or signaled its new owner", err)
+				}
+				// The next startup replaces the stale file with its real owner.
+				if err := WritePIDFile(path, os.Getpid()); err != nil {
+					t.Fatal(err)
+				}
+				if pid, err := ReadPIDFile(path); err != nil || pid != os.Getpid() {
+					t.Fatalf("live owner treated as stale: %d, %v", pid, err)
+				}
+			}
+		})
+	}
+}
+
+func TestReadPIDFileRemovesExitedWindowsProcess(t *testing.T) {
+	cmd := exec.Command(os.Args[0], "-test.run=^$")
+	if err := cmd.Run(); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "ha.pid")
+	if err := os.WriteFile(path, fmt.Appendf(nil, "%d\n", cmd.Process.Pid), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if pid, err := ReadPIDFile(path); err != nil || pid != 0 {
+		t.Fatalf("exited process accepted: %d, %v", pid, err)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatal("dead process marker not removed", err)
+	}
+}
+
+func TestPIDMarkerChangedBeforeLivenessRead(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "ha.pid")
+	// The first read saw our live PID, then a new launcher replaced its marker.
+	replacement := []byte("2147483647\n")
+	if err := os.WriteFile(path, replacement, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if pid, err := readCurrentPID(path, os.Getpid()); err == nil || pid != 0 {
+		t.Fatalf("trusted previous owner: %d, %v", pid, err)
+	}
+	if b, err := os.ReadFile(path); err != nil || string(b) != string(replacement) {
+		t.Fatal("replacement was modified", err)
+	}
+}
